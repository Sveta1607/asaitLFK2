# Скопируйте в .env и подставьте значения (без лишних пробелов в конце строк)

# Токен от @BotFather
TELEGRAM_BOT_TOKEN=

# Тот же секрет, что TELEGRAM_BOT_API_SECRET в backend/.env
TELEGRAM_BOT_API_SECRET=

# URL FastAPI: тот же хост/порт, где открывается http://127.0.0.1:3000/docs
# Если бот и бэкенд на одном ПК — обычно:
API_BASE_URL=http://127.0.0.1:3000

# OpenAI: ответы ассистента на вопросы (модель gpt-4o-mini в коде)
OPENAI_API_KEY=
# Необязательно: прокси или совместимый API (если пусто — api.openai.com)
# OPENAI_BASE_URL=

# Необязательно: таймаут запросов к бэкенду (мс); при «вечной загрузке» /start уменьши или проверь API_BASE_URL
# API_FETCH_TIMEOUT_MS=25000

# Необязательно: в консоль пишутся все входящие апдейты Telegram (отладка «бот молчит»)
# TELEGRAM_BOT_DEBUG=1

# На Amvera часто передаётся PORT = тому же числу, что containerPort; HTTP /health поднимется без дублирования BOT_HEALTH_PORT.
# BOT_HEALTH_PORT=8080
